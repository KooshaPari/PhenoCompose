# .gitattributes — Phenotype org canonical
# Auto-detect text; normalize to LF in-repo, native on checkout
* text=auto eol=lf

# Language-specific source files
*.rs    text eol=lf diff=rust
*.py    text eol=lf diff=python
*.go    text eol=lf diff=golang
*.ts    text eol=lf diff=typescript
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.zig   text eol=lf
*.mojo  text eol=lf

# Config / docs
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf diff=markdown
*.mdx   text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf

# Shell
*.sh    text eol=lf

# Windows scripting
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary (no line-ending normalization)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.mp4   binary
*.mov   binary
*.ico   binary
*.icns  binary
*.pdf   binary
*.zip   binary
*.tar.gz binary
*.woff  binary
*.woff2 binary

# Lockfiles — prevent merge conflicts but preserve exact bytes
Cargo.lock        -diff
package-lock.json -diff
bun.lockb         binary
yarn.lock         -diff
pnpm-lock.yaml    -diff
uv.lock           -diff

# Release archives exclude dev-only dirs
.github/         export-ignore
.vscode/         export-ignore
tests/           export-ignore

# LFS preventive patterns
*.exe   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
